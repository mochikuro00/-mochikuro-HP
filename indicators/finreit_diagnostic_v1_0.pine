//@version=6
indicator("金融・REIT 財務診断 v1.0", shorttitle="FinREIT 1.0", overlay=false, precision=1, max_bars_back=500)
// TradingView-only, current-data diagnostic; NOT point-in-time backtest data.
string modeInput = input.string("自動", "採点モード", options=["自動", "銀行", "保険", "REIT（不動産保有型）"])
bool stopped = input.bool(false, "判定停止（モーゲージREIT・比較不能な企業等）")
int expiry = input.int(150, "配置日からの失効日数", minval=60, maxval=365)
float minCoverage = input.float(70, "ライン最低充足率 %", minval=50, maxval=100)
float candidateCoverage = input.float(100, "候補最低充足率 %", minval=70, maxval=100)
float candidateScore = input.float(80, "候補最低点（下限）", minval=0, maxval=100)
float bankCapital = input.float(6, "銀行：普通株資本/総資産の基準 %（規制比率ではない）", minval=0.1)
float insuranceCapital = input.float(10, "保険：普通株資本/総資産の基準 %（規制比率ではない）", minval=0.1)
float bankRoe = input.float(10, "銀行：近似ROE基準 %", minval=0.1)
float insuranceRoe = input.float(10, "保険：近似ROE基準 %", minval=0.1)
float bankRoa = input.float(0.8, "銀行：ROA基準 %", minval=0.01)
float payoutMax = input.float(70, "銀行・保険：普通配当/純利益上限 %", minval=1)
float dilutionMax = input.float(3, "株数増加上限 %", minval=0)
float reitLeverage = input.float(60, "REIT：負債/総資産上限 %", minval=1, maxval=100)
float reitPayout = input.float(90, "REIT：普通配当/CFO上限 %（AFFO配当性向ではない）", minval=1)
int declineLength = input.int(126, "下落期間（日足本数）", minval=20, maxval=400)
float declineMin = input.float(20, "期間内最高終値からの下落率 %", minval=0, maxval=99)
bool relativeRequired = input.bool(false, "市場超過下落も要求")
string market = input.symbol("AMEX:SPY", "比較市場")
float excessMin = input.float(10, "市場超過下落 pp", minval=0)
bool showUpper = input.bool(true, "欠損時の上限も表示")
if barstate.isfirst and (not timeframe.isdaily or timeframe.multiplier != 1 or not chart.is_standard)
    runtime.error("標準ローソク足の1日足で使用してください。")
string industry = na(syminfo.industry) ? "" : syminfo.industry
// Conservative exact-name mapping; unknown industries require manual selection.
bool bankAuto = industry == "Major Banks" or industry == "Regional Banks" or industry == "Savings Banks"
bool insuranceAuto = industry == "Multi-Line Insurance" or industry == "Life/Health Insurance" or industry == "Property/Casualty Insurance" or industry == "Specialty Insurance"
bool reitAuto = industry == "Real Estate Investment Trusts"
string autoMode = bankAuto ? "銀行" : insuranceAuto ? "保険" : reitAuto ? "REIT（不動産保有型）" : "対象未確認"
string mode = modeInput == "自動" ? autoMode : modeInput
bool isBank = mode == "銀行"
bool isInsurance = mode == "保険"
bool isReit = mode == "REIT（不動産保有型）"
bool eligible = syminfo.type == "stock" and not stopped and (isBank or isInsurance or isReit)
string sym = ticker.standard(syminfo.tickerid)
// Snapshot only fields delivered on the same asset-feed event. No arbitrary carry-forward.
float r0 = request.financial(sym, "TOTAL_ASSETS", "FQ", gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
float r1 = request.financial(sym, "COMMON_EQUITY_TOTAL", "FQ", gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
float r2 = request.financial(sym, "NET_INCOME", "FQ", gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
float r3 = request.financial(sym, "TOTAL_SHARES_OUTSTANDING", "FQ", gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
float r4 = request.financial(sym, "COMMON_DIVIDENDS_CASH_FLOW", "FQ", gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
float r5 = request.financial(sym, "TOTAL_DEBT", "FQ", gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
float r6 = request.financial(sym, "CASH_F_OPERATING_ACTIVITIES", "FQ", gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
float r7 = request.financial(sym, "TOTAL_REVENUE", "FQ", gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
var matrix<float> q = matrix.new<float>(0, 8, na)
var array<int> ds = array.new_int()
if not na(r0)
    matrix.add_row(q, 0, array.from(r0,r1,r2,r3,r4,r5,r6,r7))
    array.unshift(ds,time)
    if matrix.rows(q) > 8
        matrix.remove_row(q,8)
        array.pop(ds)
f_cont(int back) =>
    bool ok = array.size(ds) > back
    if ok and back > 0
        for i = 0 to back - 1
            float gapDays = (array.get(ds,i)-array.get(ds,i+1))/86400000.0
            ok := ok and gapDays >= 60 and gapDays <= 125
    ok
f_q(int col,int back) =>
    f_cont(back) ? matrix.get(q,back,col) : na
f_sum(int col,int back,bool absolute) =>
    float value = na
    if f_cont(back+3)
        value := 0
        for i = back to back+3
            float part = matrix.get(q,i,col)
            value += absolute ? math.abs(part) : part
    value
f_div(float a,float b) =>
    not na(a) and not na(b) and b > 0 ? a/b : na
f_ge(float a,float b) =>
    not na(a) and not na(b) ? a >= b ? 100.0 : 0.0 : na
f_le(float a,float b) =>
    not na(a) and not na(b) ? a <= b ? 100.0 : 0.0 : na
f_pos(float a) =>
    not na(a) ? a > 0 ? 100.0 : 0.0 : na
f_growth(float a,float b) =>
    not na(a) and not na(b) ? b > 0 ? f_ge(a,b) : f_pos(a) : na
f_num(float a) =>
    na(a) ? "N/A" : str.tostring(a,"#.0")
float assets = f_q(0,0)
float equity = f_q(1,0)
float equity4 = f_q(1,4)
float ni = f_sum(2,0,false)
float ni4 = f_sum(2,4,false)
float shares = f_q(3,0)
float shares4 = f_q(3,4)
float dividends = f_sum(4,0,true)
float debt = f_q(5,0)
float cfo = f_sum(6,0,false)
float cfo4 = f_sum(6,4,false)
float revenue = f_sum(7,0,false)
float revenue4 = f_sum(7,4,false)
float capitalRatio = 100*f_div(equity,assets)
float roe = equity > 0 and equity4 > 0 ? 100*f_div(ni,(equity+equity4)/2) : na
float roa = 100*f_div(ni,(assets+f_q(0,4))/2)
float bookShare = f_div(equity,shares)
float bookShare4 = f_div(equity4,shares4)
float dilution = 100*(f_div(shares,shares4)-1)
float payout = 100*f_div(dividends,ni)
float debtRatio = 100*f_div(debt,assets)
float cfPayout = 100*f_div(dividends,cfo)
// Every mode has eight fixed modules. Missing inputs never change the denominator.
array<float> tests = array.new_float()
array<string> names = array.new_string()
array<float> weights = array.new_float()
if isReit
    tests := array.from(f_pos(cfo), f_growth(f_div(cfo,shares),f_div(cfo4,shares4)), f_le(cfPayout,reitPayout), f_le(debtRatio,reitLeverage), f_pos(equity), f_growth(revenue,revenue4), f_le(dilution,dilutionMax), f_le(debtRatio,100*f_div(f_q(5,4),f_q(0,4))))
    names := array.from("CFO黒字", "CFO/株成長（近似）", "普通配当/CFO", "負債/総資産", "普通株資本プラス", "売上成長", "株数増加抑制", "負債比率悪化なし")
    weights := array.from(15.0,20.0,15.0,20.0,5.0,10.0,5.0,10.0)
else
    float capitalMin = isBank ? bankCapital : insuranceCapital
    float roeMin = isBank ? bankRoe : insuranceRoe
    float stability = na
    if f_cont(3)
        stability := 100.0
        for i = 0 to 3
            float profit = f_q(2,i)
            stability := na(stability) or na(profit) ? na : profit > 0 ? stability : 0.0
    tests := array.from(f_ge(capitalRatio,capitalMin), f_ge(roe,roeMin), isBank ? f_ge(roa,bankRoa) : stability, f_growth(bookShare,bookShare4), f_growth(ni,ni4), f_le(payout,payoutMax), f_le(dilution,dilutionMax), f_pos(ni))
    names := array.from("普通株資本/総資産", "近似ROE", isBank ? "ROA" : "4四半期連続黒字", "簿価/株維持", "純利益成長・黒字転換", "普通配当/純利益", "株数増加抑制", "年間黒字")
    weights := isBank ? array.from(20.0,15.0,15.0,15.0,10.0,10.0,5.0,10.0) : array.from(20.0,15.0,20.0,15.0,10.0,10.0,5.0,5.0)
float lowerRaw = 0
float coverage = 0
string missing = ""
for i = 0 to 7
    float x = array.get(tests,i)
    if not na(x)
        lowerRaw += x*array.get(weights,i)/100
        coverage += array.get(weights,i)
    else
        missing += (missing == "" ? "" : " / ")+array.get(names,i)
int feed = array.size(ds)>0 ? array.get(ds,0) : na
float age = not na(feed) ? (time-feed)/86400000.0 : na
bool fresh = not na(age) and age >= 0 and age <= expiry
bool ready = eligible and fresh and coverage >= minCoverage
float lower = ready ? lowerRaw : na
float upper = ready ? math.min(100,lowerRaw+100-coverage) : na
bool core = isReit ? cfo > 0 and equity > 0 and debtRatio <= reitLeverage and cfPayout <= reitPayout : ni > 0 and equity > 0 and capitalRatio >= (isBank ? bankCapital : insuranceCapital)
bool financialCandidate = ready and coverage >= candidateCoverage and lower >= candidateScore and core
float peak = ta.highest(close,declineLength)
float drawdown = bar_index >= declineLength-1 ? 100*f_div(close-peak,peak) : na
float stockReturn = 100*(f_div(close,close[declineLength])-1)
float relativeReturn = na
if relativeRequired
    [mc,mp,mt] = request.security(market,"1D",[close,close[declineLength],time_close],gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
    relativeReturn := mt == time_close ? stockReturn-100*(f_div(mc,mp)-1) : na
bool priceReady = not na(drawdown) and (not relativeRequired or not na(relativeReturn))
bool priceCondition = priceReady and drawdown <= -declineMin and (not relativeRequired or relativeReturn <= -excessMin)
bool combined = financialCandidate and priceCondition
string status = not eligible ? "対象未確認・停止（モード確認）" : not fresh ? "配置履歴不足・失効" : not ready ? "採点データ不足" : coverage < 100 ? "欠損あり・下限～上限" : "取得済み項目の条件達成点"
plot(lower,"価格非依存 財務スコア下限",color=color.white,linewidth=3,style=plot.style_linebr)
plot(showUpper and coverage<100 ? upper : na,"欠損時上限",color=color.new(color.white,60),style=plot.style_linebr)
hline(80,"80",color=color.new(color.lime,50))
hline(60,"60",color=color.new(color.orange,50))
hline(0,"0",color=color.new(color.gray,70))
hline(100,"100",color=color.new(color.gray,70))
plot(coverage,"配点充足率 %",display=display.data_window)
plot(financialCandidate?1:0,"財務候補",display=display.data_window)
plot(combined?1:0,"財務＋下落候補",display=display.data_window)
plot(drawdown,"最高終値からの下落 %",display=display.data_window)
plot(relativeReturn,"市場超過騰落 pp",display=display.data_window)
bool confirmed = barstate.isrealtime and barstate.isconfirmed
alertcondition(confirmed and financialCandidate and not financialCandidate[1],"財務候補へ移行","{{ticker}} 金融・REIT簡易財務条件成立。規制健全性の判定ではありません。")
alertcondition(confirmed and not financialCandidate and financialCandidate[1],"財務候補から離脱","{{ticker}} 財務条件離脱・欠損・失効を確認。")
alertcondition(confirmed and combined and not combined[1],"財務＋下落候補へ移行","{{ticker}} 財務条件と価格下落条件が成立。")
alertcondition(confirmed and not combined and combined[1],"財務＋下落候補から離脱","{{ticker}} 財務または下落条件から離脱。")
var table panel = table.new(position.top_right,3,17,bgcolor=color.rgb(17,24,39),frame_color=color.gray,frame_width=1)
f_cell(int col,int row,string txt,color ink) =>
    table.cell(panel,col,row,txt,text_color=ink,text_size=size.small,text_halign=text.align_left)
if barstate.islast
    table.clear(panel,0,0,2,16)
    f_cell(0,0,syminfo.ticker+" / "+mode,color.white)
    table.cell(panel,1,0,f_num(lower),text_color=color.white,text_size=size.large)
    f_cell(2,0,"/100 "+status,color.white)
    f_cell(0,1,"充足 "+f_num(coverage)+"%",color.aqua)
    f_cell(1,1,"上限 "+f_num(upper),color.aqua)
    f_cell(2,1,"異業種モード間の点数比較不可",color.orange)
    for i = 0 to 7
        float x = array.get(tests,i)
        f_cell(0,i+2,array.get(names,i),color.white)
        f_cell(1,i+2,not eligible or not fresh ? "停止" : f_num(x),na(x)?color.gray:x==100?color.lime:color.orange)
        f_cell(2,i+2,"配点 "+f_num(array.get(weights,i)),color.silver)
    f_cell(0,10,"独立財務候補",color.white)
    f_cell(1,10,financialCandidate?"成立":"未成立・保留",financialCandidate?color.lime:color.orange)
    f_cell(2,10,"下限 "+f_num(candidateScore)+" / 充足 "+f_num(candidateCoverage)+"%",color.silver)
    f_cell(0,11,"財務＋下落",color.white)
    f_cell(1,11,combined?"成立":not priceReady?"価格データ不足":"未成立",combined?color.lime:color.orange)
    f_cell(2,11,"高値比 "+f_num(drawdown)+"% / 市場差 "+(relativeRequired?f_num(relativeReturn):"OFF"),color.silver)
    f_cell(0,12,"配置日・保存",color.white)
    f_cell(1,12,na(feed)?"N/A":str.format_time(feed,"yyyy-MM-dd"),color.silver)
    f_cell(2,12,f_num(age)+"日 / "+str.tostring(array.size(ds))+"Q（公表日ではない）",color.silver)
    f_cell(0,13,"不足項目",color.orange)
    f_cell(1,13,missing==""?"なし":missing,color.orange)
    f_cell(2,13,"FQ同日配置・当年/前年ともFQ合算",color.silver)
    f_cell(0,14,"評価対象外",color.orange)
    f_cell(1,14,isReit?"FFO/AFFO・稼働率・借換期限":isBank?"CET1・不良債権・預金流出":"引受成績・規制資本・準備金適正性",color.orange)
    f_cell(2,14,"規制上の安全性・売買推奨を示さない",color.orange)
    f_cell(0,15,"業種確認",color.white)
    f_cell(1,15,industry,color.silver)
    f_cell(2,15,isReit?"モーゲージREITは手動停止してください":"自動未対応は手動で適切なモードを選択",color.orange)
    f_cell(0,16,"主要実数",color.white)
    f_cell(1,16,isReit?"CFO配当率 "+f_num(cfPayout)+"% / 負債比 "+f_num(debtRatio)+"%":"ROE "+f_num(roe)+"% / 資本比 "+f_num(capitalRatio)+"%",color.silver)
    f_cell(2,16,"日中暫定・アラートは終値確定",color.silver)
